  },
  "license": "MIT",
  "author": "Nightlab",
  "type": "module",
  "bin": {
    "npm-release-check": "bin/npm-release-check.mjs"
  },
  "files": [
    "bin/npm-release-check.mjs",
    "skills/npm-release-check/SKILL.md",
    "CHANGELOG.md"
  ],
  "engines": {
